{
  "name": "Grace Hopper",
  "image": "ghcr.io/jabba2324/grace-hopper:latest",
  "remoteUser": "agent",

  "postCreateCommand": "code --install-extension /app/grace-hopper.vsix",
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start.sh",

  "customizations": {
    "vscode": {
      "settings": {
        "chat.enabled": false,
        "workbench.panel.chat.enabled": false,
        "inlineChat.enabled": false
      }
    }
  },

  "secrets": {
    "ANTHROPIC_API_KEY":        { "description": "Anthropic API key" },
    "ANTHROPIC_ENVIRONMENT_KEY": { "description": "Managed Agents environment key (sk-ant-oat01-...)" },
    "ANTHROPIC_ENVIRONMENT_ID":  { "description": "Managed Agents environment ID (env_...)" },
    "AGENT_ID":                  { "description": "Managed Agents agent ID (agent_...)" },
    "GITHUB_USERNAME":           { "description": "Your GitHub username" }
  }
}
