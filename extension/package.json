{
  "name": "grace-hopper",
  "displayName": "Grace Hopper",
  "description": "Live task status for the Grace Hopper autonomous agent",
  "version": "0.1.0",
  "publisher": "grace-hopper",
  "engines": { "vscode": "^1.74.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "grace-hopper-container",
          "title": "Grace Hopper",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "grace-hopper-container": [
        {
          "id": "graceHopper",
          "name": "Tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "graceHopper.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "graceHopper.rebuildState",
        "title": "Rebuild State",
        "icon": "$(debug-restart)"
      },
      {
        "command": "graceHopper.openWorkspace",
        "title": "Open Workspace Folder"
      },
      {
        "command": "graceHopper.pauseTask",
        "title": "Pause Task",
        "icon": "$(debug-pause)"
      },
      {
        "command": "graceHopper.resumeTask",
        "title": "Resume Task",
        "icon": "$(debug-continue)"
      },
      {
        "command": "graceHopper.openClaude",
        "title": "Open Claude",
        "icon": "$(terminal)"
      },
      {
        "command": "graceHopper.addRepo",
        "title": "Add Repository",
        "icon": "$(add)"
      },
      {
        "command": "graceHopper.removeRepo",
        "title": "Remove Repository",
        "icon": "$(remove)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "graceHopper.addRepo",
          "when": "view == graceHopper",
          "group": "navigation@1"
        },
        {
          "command": "graceHopper.rebuildState",
          "when": "view == graceHopper",
          "group": "navigation@2"
        },
        {
          "command": "graceHopper.refresh",
          "when": "view == graceHopper",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "graceHopper.removeRepo",
          "when": "view == graceHopper && viewItem == repo",
          "group": "inline@1"
        },
        {
          "command": "graceHopper.pauseTask",
          "when": "view == graceHopper && viewItem =~ /runningTask/",
          "group": "inline@1"
        },
        {
          "command": "graceHopper.resumeTask",
          "when": "view == graceHopper && viewItem =~ /pausedTask/",
          "group": "inline@1"
        },
        {
          "command": "graceHopper.resumeTask",
          "when": "view == graceHopper && viewItem =~ /failedTask/",
          "group": "inline@1"
        },
        {
          "command": "graceHopper.openClaude",
          "when": "view == graceHopper && viewItem =~ /WithSession/",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.74.0",
    "@vscode/vsce": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
