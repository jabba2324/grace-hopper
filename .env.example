# VS Code web server — accessible at http://<your-vps>:8080
# Use a strong password; consider putting this behind HTTPS in production
CODE_SERVER_PASSWORD=changeme
CODE_SERVER_PORT=8080

# Claude API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model to use — trade off cost vs capability
# claude-haiku-4-5-20251001  cheapest, good for most coding tasks
# claude-sonnet-4-6           default, stronger reasoning
# claude-opus-4-8             most capable, most expensive
CLAUDE_MODEL=claude-sonnet-4-6

# Ponytail coding philosophy (https://github.com/DietrichGebert/ponytail)
# lite = minimal nudge | full = active enforcement | ultra = strict | off = disabled
PONYTAIL_DEFAULT_MODE=full

# GitHub Personal Access Token
# Required scopes: repo, project, read:org (if project is under an org)
GITHUB_TOKEN=ghp_...

# Your GitHub username
GITHUB_USERNAME=chrissewell

# The repository the project board is linked to (owner/repo)
GITHUB_REPO=chrissewell/my-app

# The project number — visible in the project URL:
# https://github.com/users/chrissewell/projects/1  →  1
GITHUB_PROJECT_NUMBER=1

# Status column names in your project board (must match exactly)
PROJECT_STATUS_TODO=Todo
PROJECT_STATUS_IN_PROGRESS=In Progress
PROJECT_STATUS_IN_REVIEW=In Review

# How often to check for new tickets (seconds)
POLL_INTERVAL=60

# Git commit identity used by the agent
GIT_AUTHOR_NAME=Agent
GIT_AUTHOR_EMAIL=agent@localhost
