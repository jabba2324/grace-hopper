# VS Code web server — accessible at http://localhost:8080 (or your host's IP/domain)
# Use a strong password; if exposed remotely, put this behind a reverse proxy with TLS
CODE_SERVER_PASSWORD=changeme
CODE_SERVER_PORT=8080

# Claude API key — get from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Managed Agents — run scripts/setup_agent.py once to get these values
ANTHROPIC_ENVIRONMENT_ID=env_...
AGENT_ID=agent_...

# Environment key — generated in Anthropic Console → Environments → grace-hopper
# Format: sk-ant-oat01-...  (different from the API key above)
ANTHROPIC_ENVIRONMENT_KEY=sk-ant-oat01-...

# Model to use — set when the agent is created by setup_agent.py
# To change models: update this, then re-run setup_agent.py and update AGENT_ID
# claude-haiku-4-5-20251001  cheapest, good for most coding tasks
# claude-sonnet-4-6           mid-range, stronger reasoning
# claude-opus-4-8             most capable (default)
CLAUDE_MODEL=claude-opus-4-8

# Ponytail coding philosophy (https://github.com/DietrichGebert/ponytail)
# lite = minimal nudge | full = active enforcement | ultra = strict | off = disabled
PONYTAIL_DEFAULT_MODE=full

# GitHub Personal Access Token — classic PAT
# Required scopes: repo, project, workflow
GH_TOKEN=ghp_...

# Your GitHub username
GH_USERNAME=myusername

# How often to check for new tickets (seconds)
POLL_INTERVAL=5

# Git commit identity used by the agent
GIT_AUTHOR_NAME=Agent
GIT_AUTHOR_EMAIL=agent@localhost
